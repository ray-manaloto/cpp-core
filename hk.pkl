// hk configuration for cpp-core: https://hk.jdx.dev/configuration
//
// Developer tools come from global dotfiles-v2, Python-packaged C++/CMake tools live in
// pyproject.toml + uv.lock, and advisory CI pins live in .github/ci/mise.toml + .github/ci/mise.lock.
//
// The top-level `steps` make hk's implicit `check`, `fix` and `pre-commit` hooks: `check` only
// checks, `fix` fixes without staging, and `pre-commit` fixes, stages the result and stashes
// unstaged work. `pre-push` and `commit-msg` are declared below.
amends "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.14.0/hk@2.14.0#/Builtins.pkl"

min_hk_version = "2.14.0"

// Vendored upstream copies are checked byte for byte against upstream/manifest.json, and the repro
// sources are kept as they were run; no step may rewrite either.
exclude = List("docs/**/upstream/**", "docs/**/repro/**", "build/**", ".cache/**", ".venv/**")

local cxxGlob =
  List(
    "**/*.c",
    "**/*.h",
    "**/*.cpp",
    "**/*.hpp",
    "**/*.cc",
    "**/*.hh",
    "**/*.cxx",
    "**/*.hxx",
    "**/*.cppm",
  )

local githubGlob =
  List(
    ".github/workflows/*.yml",
    ".github/workflows/*.yaml",
    ".github/actions/**/action.yml",
    ".github/actions/**/action.yaml",
    ".github/dependabot.yml",
  )

local linters = new Mapping<String, Step> {
  // C and C++
  ["clang-format"] = (Builtins.clang_format) {
    glob = cxxGlob
    check = new CommandSpec {
      command = "uv run --locked clang-format --dry-run -Werror {{files}}"
      effect = "read"
    }
    fix = new CommandSpec {
      command = "uv run --locked clang-format -i {{files}}"
      effect = "write"
    }
  }
  ["cpp-lint"] = (Builtins.cpp_lint) {
    glob = cxxGlob
    // cpplint skips .cppm files ("not a valid file name"); cpp-lint-modules lints them.
    exclude = List("**/*.cppm")
    check = new CommandSpec {
      command = "uv run --locked cpplint --config=.cpplint {{files}}"
      effect = "read"
    }
  }
  // Module interface units. --extensions=cppm makes cpplint read them (it replaces cpplint's
  // extension list, so this step lints .cppm files only). The two filters, on top of .cpplint's,
  // drop what cpplint 2.0.2 gets wrong about modules: whitespace/blank_line, because it exempts the
  // blank lines inside `namespace x {` but not inside `export namespace x {`; and
  // build/include_subdir, because a module includes its private headers, such as
  // modules/logging/format.hpp, by bare name from its own directory.
  ["cpp-lint-modules"] = (Builtins.cpp_lint) {
    glob = List("**/*.cppm")
    check = new CommandSpec {
      command =
        "uv run --locked cpplint --config=.cpplint --extensions=cppm --filter=-whitespace/blank_line,-build/include_subdir {{files}}"
      effect = "read"
    }
  }

  // CMake. hk has no gersemi builtin; .gersemirc holds the style. The overlay ports keep vcpkg's
  // own portfile style, and a portfile edit changes the port's ABI hash.
  ["gersemi"] {
    glob = List("**/CMakeLists.txt", "**/*.cmake")
    exclude = List("ports/**")
    batch = true
    check = new CommandSpec {
      command = "uv run --locked gersemi --check {{files}}"
      effect = "read"
    }
    fix = new CommandSpec {
      command = "uv run --locked gersemi --in-place {{files}}"
      effect = "write"
    }
  }

  // TOML. tombi both lints and formats, so taplo is not used.
  ["tombi"] = (Builtins.tombi) {
    exclude = List(".typos.toml")
  }
  ["tombi-format"] = (Builtins.tombi_format) {
    exclude = List(".typos.toml", ".mise.toml", ".github/ci/mise.toml", "mise/**/*.toml")
  }

  // JSON
  ["prettier"] = (Builtins.prettier) {
    glob = List("**/*.json", "**/*.jsonc", "**/*.json5")
    // Derived by scripts/*.py in their own layout, and checked against a fresh derivation.
    exclude =
      List(
        ".github/ci/.mise/locks/**",
        "docs/cxx26-features-audit/audit-index.json",
        "docs/cxx26-features-audit/citations.json",
        "docs/cxx26-features-audit/measurements.json",
      )
  }

  // Renovate's own validator, so a renovate.json change is checked before it reaches Renovate.
  // --no-global checks it as repository config; a named file is otherwise read as self-hosted
  // global config. Its "RE2 not usable" warning is expected: aube skips re2's native build, so
  // regexes are checked with JavaScript RegExp, not RE2 as Mend runs them. After a regex change,
  // read the next Mend run's log for errors.
  ["renovate-config"] {
    glob = List("renovate.json")
    check = new CommandSpec {
      command = "renovate-config-validator --strict --no-global renovate.json"
      effect = "read"
    }
  }

  // Markdown and prose
  ["rumdl-format"] = (Builtins.rumdl_format) {
    glob = List("**/*.md", "**/*.markdown")
  }
  ["rumdl"] = (Builtins.rumdl) {
    glob = List("**/*.md", "**/*.markdown")
  }
  ["lychee"] = (Builtins.lychee) {
    glob = List("**/*.md", "**/*.markdown")
  }
  ["typos"] = (Builtins.typos) {
    glob =
      List(
        "**/*.md",
        "**/*.markdown",
        "**/*.txt",
        "**/*.rst",
        "**/*.adoc",
        "**/*.cpp",
        "**/*.hpp",
        "**/*.c",
        "**/*.h",
        "**/*.cmake",
        "**/*.py",
        "**/*.sh",
        "**/*.toml",
        "**/*.yaml",
        "**/*.yml",
        "**/*.json",
      )
    // Mirrors .typos.toml's extend-exclude, so hk does not hand typos files it would skip.
    exclude =
      List(
        "docs/**",
        "ports/**",
        "**/upstream/**",
        "**/repro/**",
        ".github/ci/.mise/**",
        ".github/ci/mise.lock",
        ".opencode/**",
        "build/**",
        "uv.lock",
      )
  }

  // Secrets and dependencies
  ["betterleaks"] = Builtins.betterleaks
  ["kingfisher"] = Builtins.kingfisher
  ["osv-scanner"] = (Builtins.osv_scanner) {
    glob = List("**/vcpkg.json", "**/*.lock")
  }

  // GitHub Actions and containers: cpp-core has neither today; these run only if some are added.
  ["jactionlint"] = (Builtins.jactionlint) {
    glob = githubGlob
  }
  ["zizmor"] = (Builtins.zizmor) {
    glob = githubGlob
  }
  ["hadolint"] = (Builtins.hadolint) {
    glob = List("**/Dockerfile", "**/Dockerfile.*", "**/*.dockerfile")
  }

  // Shell and Python
  ["shfmt"] = Builtins.shfmt
  ["shellcheck"] = Builtins.shellcheck
  ["ruff-format"] = Builtins.ruff_format
  ["ruff"] = Builtins.ruff
  ["ty"] = Builtins.ty
  ["python-check-ast"] = Builtins.python_check_ast
  ["python-debug-statements"] = Builtins.python_debug_statements

  // Repository hygiene
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["check-case-conflict"] = Builtins.check_case_conflict
  ["check-added-large-files"] = (Builtins.check_added_large_files) {
    allow_binary = true
  }
  ["check-executables-have-shebangs"] = Builtins.check_executables_have_shebangs
  ["check-shebang-scripts-are-executable"] = Builtins.check_shebang_scripts_are_executable
  ["check-symlinks"] = (Builtins.check_symlinks) {
    allow_symlinks = true
  }
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["newlines"] = Builtins.newlines
  ["mixed-line-ending"] = Builtins.mixed_line_ending
  ["fix-smart-quotes"] = Builtins.fix_smart_quotes
  ["byte-order-marker"] = Builtins.byte_order_marker
  ["destroyed-symlinks"] = Builtins.destroyed_symlinks
  ["detect-private-key"] = Builtins.detect_private_key
  ["forbid-submodules"] = Builtins.forbid_submodules

  // The tool configs themselves
  ["pkl-format"] {
    glob = List("**/*.pkl")
    check = new CommandSpec { command = "pkl format --diff-name-only {{files}}"; effect = "read" }
    fix = new CommandSpec { command = "pkl format --write {{files}}"; effect = "write" }
  }
  ["mise-fmt"] {
    glob =
      List(
        "mise.toml",
        ".mise.toml",
        "mise.local.toml",
        ".mise.local.toml",
        ".github/ci/mise.toml",
        "mise/**/*.toml",
      )
    check = new CommandSpec {
      command = "mise fmt --check && mise -C .github/ci fmt --check"
      effect = "read"
    }
    // `mise fmt` rewrites in place; it has no --write flag.
    fix = new CommandSpec { command = "mise fmt && mise -C .github/ci fmt"; effect = "write" }
  }
  ["hk-validate"] {
    glob = List("hk.pkl")
    check = new CommandSpec { command = "hk validate --deny-warnings"; effect = "read" }
  }

  // The audit's own checker. It reads the whole tree (citations, vendored copies, derived JSON),
  // so it runs in check, fix, pre-commit and pre-push (not commit-msg, which checks only the
  // message), and alone, after no formatter is still writing.
  ["audit-verify"] {
    exclusive = true
    check = new CommandSpec { command = "python3 scripts/verify_audit.py --quiet"; effect = "read" }
  }
  // Every `mise run <task>` a doc or script tells a reader to type must be a task or alias.
  ["docs-commands"] {
    glob = List("**/*.md", "scripts/*.py", "mise/**/*.toml", ".mise.toml")
    check = new CommandSpec {
      command = "python3 scripts/check_doc_commands.py --self-test"
      effect = "read"
    }
  }
}

// .github/ci/mise.lock and uv.lock must match .github/ci/mise.toml and pyproject.toml. Fast, so
// it runs on `hk check` and pre-push, not pre-commit. `mise run tools:lock-verify` does the slow
// install-from-lock proof.
local lockCheck = new Mapping<String, Step> {
  ["mise-lock"] {
    glob =
      List(
        ".mise.toml",
        ".github/ci/mise.toml",
        ".github/ci/mise.lock",
        "pyproject.toml",
        "uv.lock",
      )
    check = new CommandSpec {
      command = "python3 scripts/check_mise_lock.py --self-test && uv lock --check --offline"
      effect = "read"
    }
  }
}

steps {
  ...linters
}

hooks {
  ["check"] {
    steps {
      ...lockCheck
      // `hk check` only: a release check wants nothing uncommitted.
      ["check-clean-workspace"] {
        check = new CommandSpec {
          effect = "read"
          command =
            """
            if [ -n "$(git status --porcelain)" ]; then
              echo "ERROR: Dirty git workspace detected:"
              git status --short
              exit 1
            fi
            echo "Git workspace is clean"
            """
        }
      }
    }
  }
  ["pre-push"] {
    steps {
      ...linters
      ...lockCheck
    }
  }
  ["commit-msg"] {
    steps {
      ["check-conventional-commit"] = Builtins.check_conventional_commit
    }
  }
}
